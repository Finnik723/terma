<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>io.github.finnik723.terma</groupId>
  <artifactId>terma</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules><module>backend</module><module>worker</module></modules>
  <properties><java.version>25</java.version></properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions><execution><id>toolchain</id><goals><goal>enforce</goal></goals>
          <configuration><rules>
            <requireJavaVersion><version>[25,26)</version><message>Java 25 is required. See .java-version and docs/development.md.</message></requireJavaVersion>
            <requireMavenVersion><version>[3.10.0]</version><message>Use the committed Maven Wrapper (Maven 3.10.0).</message></requireMavenVersion>
          </rules></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
