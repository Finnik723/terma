{
  "name": "terma-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "24.22.1", "npm": "11.19.1" },
  "scripts": {
    "preinstall": "node ../tools/check-frontend-toolchain.mjs",
