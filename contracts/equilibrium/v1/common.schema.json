{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terma:equilibrium:1.0:common",
  "title": "Общие определения контракта Terma 1.0",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "versionRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "id",
        "versionId"
      ],
      "additionalProperties": false
    },
    "implementationRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "elementAmounts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][a-z]?$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "minProperties": 1,
      "not": {
        "additionalProperties": {
          "const": 0
        }
      }
    },
    "stoichiometry": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][a-z]?$"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minProperties": 1
    },
    "conditions": {
      "type": "object",
      "properties": {
        "temperatureK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressurePa": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "temperatureK",
        "pressurePa"
      ],
      "additionalProperties": false
    },
    "solverOptions": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "balanceAbsoluteToleranceMol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "balanceRelativeTolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "propertyCode": {
      "anyOf": [
        {
          "enum": [
            "GIBBS_ENERGY",
            "PH",
            "VOLUME"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z][A-Za-z0-9._-]*$"
        }
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "GIBBS_ENERGY",
                "PH",
                "VOLUME"
              ]
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z][A-Za-z0-9._-]*$"
            }
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "referenceConvention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "GIBBS_ENERGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "J"
              }
            },
            "required": [
              "referenceConvention"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "PH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "VOLUME"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "m3"
              }
            }
          }
        }
      ]
    },
    "phaseType": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "examples": [
        "SOLID",
        "LIQUID",
        "AQUEOUS",
        "GAS",
        "FLUID",
        "OTHER"
      ]
    }
  }
}
