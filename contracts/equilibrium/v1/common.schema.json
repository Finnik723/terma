{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terma:equilibrium:1.0:common",
  "title": "Общие определения контракта Terma 1.0",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "versionRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "id",
        "versionId"
      ],
      "additionalProperties": false
    },
    "implementationRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "elementAmounts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][a-z]?$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "minProperties": 1,
      "not": {
        "additionalProperties": {
          "const": 0
        }
      }
    },
    "stoichiometry": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][a-z]?$"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minProperties": 1
    },
    "conditions": {
      "type": "object",
      "properties": {
        "temperatureK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressurePa": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "temperatureK",
        "pressurePa"
      ],
      "additionalProperties": false
    },
    "solverOptions": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "balanceAbsoluteToleranceMol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "balanceRelativeTolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "propertyCode": {
      "anyOf": [
        {
          "enum": [
            "GIBBS_ENERGY",
            "PH",
            "VOLUME",
            "ACTIVITY",
            "ACTIVITY_COEFFICIENT",
            "CHEMICAL_POTENTIAL"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z][A-Za-z0-9._-]*$"
        }
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/propertyCode"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "referenceConvention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/standardPropertyUnits"
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "GIBBS_ENERGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {},
            "required": [
              "referenceConvention"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CHEMICAL_POTENTIAL"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {},
            "required": [
              "referenceConvention"
            ]
          }
        }
      ]
    },
    "phaseType": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "examples": [
        "SOLID",
        "LIQUID",
        "AQUEOUS",
        "GAS",
        "FLUID",
        "OTHER"
      ]
    },
    "contractVersionIdentifier": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "propertyScope": {
      "enum": [
        "SYSTEM",
        "PHASE",
        "SPECIES"
      ]
    },
    "standardPropertyUnits": {
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "GIBBS_ENERGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "J"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "PH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "VOLUME"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "m3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY_COEFFICIENT"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CHEMICAL_POTENTIAL"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "J/mol"
              }
            }
          }
        }
      ]
    },
    "standardPropertyScopes": {
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "GIBBS_ENERGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "SYSTEM",
                  "PHASE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "PH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "PHASE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "VOLUME"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "SYSTEM",
                  "PHASE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "SPECIES"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY_COEFFICIENT"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "SPECIES"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CHEMICAL_POTENTIAL"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "enum": [
                  "SPECIES"
                ]
              }
            }
          }
        }
      ]
    },
    "propertyRequirement": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/propertyCode"
        },
        "scope": {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/propertyScope"
        }
      },
      "required": [
        "code",
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/standardPropertyScopes"
        }
      ]
    },
    "propertyDescriptor": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/propertyCode"
        },
        "valueType": {
          "const": "NUMBER"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/propertyScope"
        },
        "referenceConventionRequired": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "valueType",
        "unit",
        "scope",
        "referenceConventionRequired",
        "description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/standardPropertyUnits"
        },
        {
          "$ref": "urn:terma:equilibrium:1.0:common#/$defs/standardPropertyScopes"
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "GIBBS_ENERGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "PH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "VOLUME"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ACTIVITY_COEFFICIENT"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CHEMICAL_POTENTIAL"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "referenceConventionRequired": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "solverOptionDescriptor": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "maxIterations",
            "balanceAbsoluteToleranceMol",
            "balanceRelativeTolerance"
          ]
        },
        "valueType": {
          "enum": [
            "INTEGER",
            "NUMBER"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "default": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "valueType",
        "unit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "maxIterations"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "valueType": {
                "const": "INTEGER"
              },
              "unit": {
                "const": "1"
              },
              "minimum": {
                "type": "integer",
                "minimum": 1
              },
              "maximum": {
                "type": "integer",
                "minimum": 1
              },
              "default": {
                "type": "integer",
                "minimum": 1
              }
            },
            "not": {
              "required": [
                "exclusiveMinimum"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "balanceAbsoluteToleranceMol"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "valueType": {
                "const": "NUMBER"
              },
              "unit": {
                "const": "mol"
              },
              "minimum": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maximum": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "default": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exclusiveMinimum": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "balanceRelativeTolerance"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "valueType": {
                "const": "NUMBER"
              },
              "unit": {
                "const": "1"
              },
              "minimum": {
                "type": "number",
                "minimum": 0
              },
              "maximum": {
                "type": "number",
                "minimum": 0
              },
              "default": {
                "type": "number",
                "minimum": 0
              },
              "exclusiveMinimum": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "minimum",
              "exclusiveMinimum"
            ]
          }
        }
      ]
    }
  }
}
