# Spring Boot reads process environment, not this file automatically.
# Example placeholders only: use external environment or a private Spring config file.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.invalid:5432/terma_example
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# false only for loopback HTTP development; HTTPS requires true.
TERMA_SESSION_COOKIE_SECURE=false
# Demo provisioning is opt-in; enter passwords securely as described in docs/authentication.md.
TERMA_DEMO_ACCOUNTS_ENABLED=false
